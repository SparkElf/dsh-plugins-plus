{
  "name": "@sparkelf/dsh-knowledge-base",
  "version": "0.1.14",
  "description": "DataOps-backed knowledge base for DeepSeek Harness: a left-sidebar destination, Settings configuration, and index tooling over a mounted NAS view.",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "SKILL.md",
    "万相AI使用教程.html",
    "i18n/*.json",
    "skills/**/SKILL.md",
    "skills/**/i18n/*.json"
  ],
  "scripts": {
    "build": "rm -rf lib && tsc -p tsconfig.build.json && tsdown",
    "bundle": "tsdown",
    "prepack": "pnpm run build"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SparkElf/dsh-plugins-plus.git",
    "directory": "packages/knowledge-base"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-locale": ">=0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.7-rc.2",
    "@deepseek-ai/dsh-credentials": ">=0.1.7-rc.2",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.7-rc.2",
    "@deepseek-ai/dsh-tools": ">=0.1.7-rc.2",
    "react": ">=18.2.0 <20",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.2.1-alpha.2",
    "dsh-better-sidebar": ">=0.25.0",
    "@deepseek-ai/dsh-client-ui-session": ">=0.2.1-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-client-locale": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.7-rc.2",
    "@deepseek-ai/dsh-credentials": "0.1.7-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.2",
    "@types/react": "~18.3.1",
    "jsdom": "^26.1.0",
    "lightningcss": "^1.32.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-alpha.2",
    "dsh-better-sidebar": "0.25.0",
    "@deepseek-ai/dsh-client-ui-session": "0.2.1-alpha.2"
  },
  "peerDependenciesMeta": {
    "dsh-better-sidebar": {
      "optional": true
    }
  }
}
