{
  "name": "@sparkelf/dsh-mobile-bridge",
  "version": "0.1.0",
  "type": "module",
  "description": "DeepSeek Harness plugin: outbound tunnel to the mobile bridge server plus a narrow-width mobile overlay reusing the stock design system.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "inject": [], "platform": "web" }
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-settings": "0.0.1-rc.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "react": "^18.2.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0"
  }
}
