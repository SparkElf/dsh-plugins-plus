{
  "name": "@sparkelf/dsh-mobile-bridge",
  "version": "0.2.4",
  "description": "DeepSeek Harness plugin: an outbound E2EE tunnel, mobile presentation, and first-class Mobile Bridge settings section.",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf lib && tsc -p tsconfig.build.json && tsdown",
    "bundle": "tsdown",
    "prepack": "pnpm run build"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SparkElf/dsh-plugins-plus.git",
    "directory": "packages/mobile-bridge"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.0.1-rc.1 <1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.0.1-rc.1 <1",
    "@deepseek-ai/dsh-settings": ">=0.0.1-rc.1 <1",
    "react": ">=18.2.0 <20"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.0.1-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.0.1-rc.1",
    "@deepseek-ai/dsh-invariants": "0.0.1-rc.1",
    "@deepseek-ai/dsh-settings": "0.0.1-rc.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "~18.3.1",
    "lightningcss": "^1.32.0",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "tsdown": "^0.22.2"
  }
}
