{
  "name": "@sparkelf/dsh-plugin-supervisor",
  "version": "0.1.1",
  "packageManager": "pnpm@11.7.0",
  "description": "Out-of-process Plus runtime Supervisor with controlled Session recovery",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": "./runtime/client.mjs",
    "./manifest": "./runtime/manifest.mjs",
    "./run": "./runtime/supervisor.mjs",
    "./bin": "./runtime/bin.mjs",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/bin.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "runtime/**/*.mjs",
    "progress/**/*",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "dsh-plus-supervisor": "lib/bin.js"
  },
  "scripts": {
    "build": "rm -rf lib && tsc -p tsconfig.build.json && tsdown",
    "bundle": "tsdown",
    "test": "node --test test/*.node-test.mjs",
    "pack:check": "node scripts/verify-pack.mjs",
    "prepack": "pnpm run build"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SparkElf/dsh-plugins-plus.git",
    "directory": "packages/supervisor"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-api-session-controller": ">=0.1.2-alpha.2",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.2-alpha.2",
    "@deepseek-ai/dsh-invariants": ">=0.1.2-alpha.2",
    "@deepseek-ai/dsh-session": ">=0.1.2-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-api-session-controller": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-invariants": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-session": "0.1.2-alpha.2",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3"
  }
}
